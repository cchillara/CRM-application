generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String                   @id @default(uuid())
  name               String
  status             OrganizationStatus       @default(ACTIVE)
  email              String?
  phone              String?
  website            String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  planId             String?
  subscriptionStatus String?
  paymentStatus      String?
  billingCycle       String?
  subscriptionAmount Float?
  activities         Activity[]
  auditLogs          AuditLog[]
  companies          Company[]
  customers          Customer[]
  deals              Deal[]
  followUps          FollowUp[]
  leads              Lead[]
  invitations        OrganizationInvitation[]
  supportTickets     SupportTicket[]
  tasks              Task[]
  teams              Team[]
  users              User[]
}

model User {
  id                  String           @id @default(uuid())
  firebaseUid         String           @unique
  email               String           @unique
  firstName           String
  lastName            String?
  role                UserRole         @default(SALES)
  status              UserStatus       @default(INVITED)
  lastLoginAt         DateTime?
  organizationId      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  department          String?
  phone               String?
  jobTitle            String?
  performedActivities Activity[]       @relation("ActivityPerformedBy")
  auditLogs           AuditLog[]
  assignedDeals       Deal[]           @relation("DealAssignedTo")
  assignedLeads       Lead[]           @relation("LeadAssignedTo")
  convertedLeads      Lead[]           @relation("LeadConvertedBy")
  assignedTasks       Task[]           @relation("TaskAssignedTo")
  teamMemberships     TeamMembership[]
  organization        Organization?    @relation(fields: [organizationId], references: [id])
}

model Team {
  id             String           @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  members        TeamMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMembership {
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           UserRole
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Company {
  id             String       @id @default(uuid())
  name           String
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  contacts       Contact[]
  customers      Customer[]
  leads          Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Contact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  jobTitle  String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  leads     Lead[]

  @@index([companyId])
}

model Lead {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         LeadStatus   @default(NEW)
  source         LeadSource   @default(OTHER)
  organizationId String
  companyId      String?
  contactId      String?
  assignedToId   String?
  convertedAt    DateTime?
  convertedById  String?
  customerId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  assignedTo     User?        @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])
  convertedBy    User?        @relation("LeadConvertedBy", fields: [convertedById], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  tasks          Task[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([companyId])
  @@index([contactId])
  @@index([customerId])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  productId      String
  organizationName String    @default("")
  name           String
  description    String?
  category       String
  pricing        Int
  billingCycle   BillingCycle
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, productId])
  @@index([organizationId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  company        Company      @relation(fields: [companyId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  deals          Deal[]
  leads          Lead[]
  tasks          Task[]

  @@unique([organizationId, companyId])
  @@index([organizationId])
  @@index([companyId])
}

model Deal {
  id             String       @id @default(uuid())
  title          String
  description    String?
  value          Decimal?
  stage          DealStage    @default(PROSPECTING)
  organizationId String
  customerId     String
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  assignedTo     User?        @relation("DealAssignedTo", fields: [assignedToId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  tasks          Task[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([customerId])
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  organizationId String
  assignedToId   String
  leadId         String?
  customerId     String?
  dealId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedTo     User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
}

model FollowUp {
  id               String       @id @default(uuid())
  entityType       String
  entityId         String
  description      String
  nextFollowUpDate String?
  author           String?
  organizationId   String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
}

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType
  description    String
  organizationId String
  performedById  String
  leadId         String?
  customerId     String?
  dealId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer?    @relation(fields: [customerId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  performedBy    User         @relation("ActivityPerformedBy", fields: [performedById], references: [id])

  @@index([organizationId])
  @@index([performedById])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
}
model ClientAdmin{
  id       String  @id  @default(uuid())
  firebaseUid   String @unique
  email         String @unique
  name          String
  phone         String
  designation   String
  organizationName  String
  role          String
  passwordLastChangedAt DateTime
}

model SuperAdmin {
  id                    String    @id @default(uuid())
  firebaseUid           String    @unique
  email                 String    @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  name                  String?
  phone                 String?
  designation           String?
  passwordLastChangedAt DateTime?
}
model SubscriptionPlan {
  id        String   @id
  name      String
  price     Float
  billing   String
  userLimit Int
  features  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id        String   @id @default("global")
  settings  Json
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id             String        @id @default(uuid())
  organizationId String?
  subject        String
  category       String
  priority       String
  status         String        @default("OPEN")
  message        String
  replies        Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status, createdAt])
}

enum UserRole {
  ORGANIZATION_ADMIN
  MANAGER
  SALES
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  PENDING
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  PHONE
  ADVERTISEMENT
  OTHER
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
}
